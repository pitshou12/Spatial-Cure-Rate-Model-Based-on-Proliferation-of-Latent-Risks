/*Data Import */
PROC IMPORT OUT=FCRData
            DATAFILE= "\\tsclient\Remote virtual drive\Uploads\Survival_Rust_FCRData-original.csv"
            DBMS=CSV REPLACE;
			
GETNAMES=YES; 
RUN;

data FCRData;
set FCRData;
if Stage=1 then BCstage='Local';
else if Stage=2 then BCstage='Regional';
else BCstage='Distant';
Time=Survival/365;
x1=TX_Delay;x2=BX_Delay;
if Tgrade=2 then x3=1;else x3=0;
if Tgrade=3 then x4=1;else x4=0;
x5=HR_p;x6=Age-62;
run;

proc sort data=FCRData out=FCR;
by BCstage;
run;

proc lifetest data=FCR outsurv=surv_exp noprint;
  time Time*death(0);
  strata Race;
  by BCstage;
run;

data surv_exp1;
set surv_exp;
if BCstage='Local';
run;

options nobyline;
proc sgplot data=surv_exp noautolegend noborder;
    /* Step plot for survival curves */
    step x=Time y=SURVIVAL / group=Race name="SurvLine" lineattrs=(thickness=2);
	by BCstage;
	yaxis label='survival probability' values=(0 0.2 0.4 0.6 0.8 1)
	       labelattrs=(weight=bold family="Arial" size=18)
           valueattrs=(weight=bold size=18 color=black);
     xaxis label='time (years)' max=8
	       labelattrs=(weight=bold family="Arial" size=18)
           valueattrs=(weight=bold size=18 color=black);
run;

options nobyline;
proc sgplot data=surv_exp1 noautolegend noborder;
    /* Step plot for survival curves */
    step x=Time y=SURVIVAL / group=Race name="SurvLine" lineattrs=(thickness=2);
	by BCstage;
	yaxis label=' ' values=(0 0.2 0.4 0.6 0.8 1)
	       labelattrs=(weight=bold family="Arial" size=18)
           valueattrs=(weight=bold size=18 color=black);
     xaxis label='time (years)' max=8
	       labelattrs=(weight=bold family="Arial" size=18)
           valueattrs=(weight=bold size=18 color=black);
run;

/*For EA race */
data FCR_EA1;
set FCRData;
if Race=1;
run;

proc sort data=FCR_EA1 out=FCR_EA;
by BCstage;
run;

/*Bayesian Estimates of SSVLR_P model for EA*/
PROC MCMC DATA=FCR_EA outpost=EA1 seed=21228 nmc=50000 nbi=10000 opti = quanew STATS=ALL dic
monitor=(beta0 beta1 beta2 beta3 beta4 beta5 beta6 lambda gamma1);
PARMS beta0=0.28,beta1=0.17,beta2=0.04,beta3=0.06,beta4=0.13,beta5=-0.19,beta6=-0.004,lambda=5,gamma1=0.2;
PRIOR beta0 ~ normal(0.28,sd=0.1);PRIOR beta1 ~ normal(0.17,sd=0.05);PRIOR beta2 ~ normal(0.04,sd=0.05);
PRIOR beta3 ~ normal(0.06,sd=0.05);PRIOR beta4 ~ normal(0.13,sd=0.05);PRIOR beta5 ~ normal(-0.19,sd=0.05);
PRIOR beta6 ~ normal(-0.004,sd=0.05);
PRIOR lambda ~ normal(3,sd=0.1,lower=0); 
PRIOR gamma1 ~ normal(0.2,sd=0.004,lower=0);
by BCstage;
theta = exp(beta0+beta1*x1+beta2*x2+beta3*x3+beta4*x4+beta5*x5+beta6*x6);
*cure_Eur=exp(-exp(beta0));
*cure_Afr=exp(-exp(beta0+beta1));
*cure_Asian=exp(-exp(beta0+beta2));
alpha= gamma1 / lambda;
Sc= exp(-theta*(1-exp(-gamma1*Time+alpha-alpha*exp(-lambda*Time))));
hc=theta*(gamma1-alpha*lambda*exp(-lambda*Time))*exp(-gamma1*Time+alpha-alpha*exp(-lambda*Time));
if (hc>0 and Sc>0);
fc=hc*Sc;
L=death*log(fc)+(1-death)*log(Sc);
MODEL Time ~ GENERAL(L);
RUN;

/*Bayesian Estimates of SSVLR_B model for EA*/
PROC MCMC DATA=FCR_EA outpost=EA2 seed=21228 nmc=50000 nbi=10000 opti = quanew STATS=ALL dic
monitor=(beta0 beta1 beta2 beta3 beta4 beta5 beta6 lambda gamma1);
PARMS beta0=0.56,beta1=0.23,beta2=-0.05,beta3=0.03,beta4=0.18,beta5=-0.5,beta6=0.0003,lambda=5,gamma1=0.2;
PRIOR beta0 ~ normal(0.56,sd=0.1);PRIOR beta1 ~ normal(0.23,sd=0.05);PRIOR beta2 ~ normal(-0.05,sd=0.05);
PRIOR beta3 ~ normal(0.03,sd=0.05);PRIOR beta4 ~ normal(0.18,sd=0.05);PRIOR beta5 ~ normal(-0.5,sd=0.05);
PRIOR beta6 ~ normal(0.0003,sd=0.05);
PRIOR lambda ~ normal(5,sd=0.1,lower=0); 
PRIOR gamma1 ~ normal(0.2,sd=0.004,lower=0);
by BCstage;
theta1 = exp(beta0+beta1*x1+beta2*x2+beta3*x3+beta4*x4+beta5*x5+beta6*x6);
theta = theta1/(1+theta1);
*cure_Eur=1-(exp(beta0)/(1+exp(beta0)));;
*cure_Afr=1-(exp(beta0+beta1)/(1+exp(beta0+beta1)));
*cure_Asian=1-(exp(beta0+beta2)/(1+exp(beta0+beta2)));
alpha= gamma1 / lambda;
Sc= 1-theta*(1-exp(-gamma1*Time+alpha-alpha*exp(-lambda*Time)));
fc=theta*(gamma1-alpha*lambda*exp(-lambda*Time))*exp(-gamma1*Time+alpha-alpha*exp(-lambda*Time));
if (fc>0 and Sc>0);
hc=fc/Sc;
L=death*log(fc)+(1-death)*log(Sc);
MODEL Time ~ GENERAL(L);
RUN;

