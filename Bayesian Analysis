/*Data Import */
PROC IMPORT OUT=FCRData
            DATAFILE= "\\tsclient\Remote virtual drive\Uploads\Survival_Rust_FCRData-original.csv"
            DBMS=CSV REPLACE;
			
GETNAMES=YES; 
RUN;

data FCRData;
set FCRData;
if Stage=1 then BCstage='Local';
else if Stage=2 then BCstage='Regional';
else BCstage='Distant';
Time=Survival/365;
x1=TX_Delay;x2=BX_Delay;
if Tgrade=2 then x3=1;else x3=0;
if Tgrade=3 then x4=1;else x4=0;
x5=HR_p;x6=Age;
run;

proc sort data=FCRData out=FCR;
by BCstage;
run;

proc lifetest data=FCR outsurv=surv_exp noprint;
  time Time*death(0);
  strata Race;
  by BCstage;
run;

data surv_exp1;
set surv_exp;
if BCstage='Local';
run;

options nobyline;
proc sgplot data=surv_exp noautolegend noborder;
    /* Step plot for survival curves */
    step x=Time y=SURVIVAL / group=Race name="SurvLine" lineattrs=(thickness=2);
	by BCstage;
	yaxis label='survival probability' values=(0 0.2 0.4 0.6 0.8 1)
	       labelattrs=(weight=bold family="Arial" size=18)
           valueattrs=(weight=bold size=18 color=black);
     xaxis label='time (years)' max=8
	       labelattrs=(weight=bold family="Arial" size=18)
           valueattrs=(weight=bold size=18 color=black);
run;

options nobyline;
proc sgplot data=surv_exp1 noautolegend noborder;
    /* Step plot for survival curves */
    step x=Time y=SURVIVAL / group=Race name="SurvLine" lineattrs=(thickness=2);
	by BCstage;
	yaxis label=' ' values=(0 0.2 0.4 0.6 0.8 1)
	       labelattrs=(weight=bold family="Arial" size=18)
           valueattrs=(weight=bold size=18 color=black);
     xaxis label='time (years)' max=8
	       labelattrs=(weight=bold family="Arial" size=18)
           valueattrs=(weight=bold size=18 color=black);
run;

data FCR_local;
set FCRData;
if Stage=1;
run;


/*Bayesian Estimates and cure-rates for SSVLR_P model in local stratum*/
PROC MCMC DATA=FCR_local outpost=FCR_local1 seed=21228 nmc=50000 nbi=10000 opti = quanew STATS=ALL dic
monitor=(beta0 beta1 beta2 beta3 beta4 beta5 beta6);
PARMS beta0=-10,beta1=0,beta2=0,beta3=0,beta4=0,beta5=0,beta6=0,lambda=1,gamma1=0.004;
PRIOR beta0 ~ normal(-10,sd=0.1);PRIOR beta1 ~ normal(0,sd=0.05);PRIOR beta2 ~ normal(0,sd=0.05);
PRIOR beta3 ~ normal(0,sd=0.05);PRIOR beta4 ~ normal(0,sd=0.05);PRIOR beta5 ~ normal(0,sd=0.05);
PRIOR beta6 ~ normal(0,sd=0.05);
PRIOR lambda ~ normal(1,sd=0.1,lower=0); 
PRIOR gamma1 ~ normal(0.008,sd=0.004,lower=0);
theta = exp(beta0+beta1*x1+beta2*x2+beta3*x3+beta4*x4+beta5*x5+beta6*x6);
*cure_Eur=exp(-exp(beta0));
*cure_Afr=exp(-exp(beta0+beta1));
*cure_Asian=exp(-exp(beta0+beta2));
alpha= gamma1 / lambda;
Sc= exp(-theta*(1-exp(-gamma1*Time+alpha-alpha*exp(-lambda*Time))));
hc=theta*(gamma1-alpha*lambda*exp(-lambda*Time))*exp(-gamma1*Time+alpha-alpha*exp(-lambda*Time));
fc=hc*Sc;
L=death*log(fc)+(1-death)*log(Sc);
MODEL Time ~ GENERAL(L);
RUN;

